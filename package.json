{
  "name": "mcp-security-compliance",
  "version": "0.3.0",
  "description": "MCP server for security compliance frameworks — ISO 27001, NIST 800-53, OWASP ASVS, NIST SSDF, ISO 27017 — with official cross-framework mappings",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify-iso": "bun run scripts/verify-iso-controls.ts",
    "update-sources": "bun run scripts/update-sources.ts",
    "evidence": "bun run scripts/generate-evidence-index.ts",
    "init": "bun run scripts/init.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
