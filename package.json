{
  "name": "mcp-custos",
  "version": "0.4.1",
  "description": "MCP server for secure coding and compliance — full MITRE CWE corpus, ISO 27001, NIST 800-53, OWASP ASVS, NIST SSDF, ISO 27017 — with official cross-framework mappings and enforcement hooks",
  "type": "module",
  "license": "MIT",
  "author": "an0malous",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/an0malous/mcp-custos.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "compliance",
    "secure-coding",
    "cwe",
    "nist-800-53",
    "iso-27001",
    "owasp-asvs",
    "ssdf"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "bin": {
    "mcp-custos": "src/index.ts",
    "custos-precheck-edit": "scripts/precheck-edit.ts",
    "custos-check-citations": "scripts/check-compliance-citations.ts",
    "custos-evidence": "scripts/generate-evidence-index.ts",
    "custos-init": "scripts/init.ts"
  },
  "files": [
    "src/**/*.ts",
    "src/data/*.json",
    "!src/**/*.test.ts",
    "scripts/precheck-edit.ts",
    "scripts/check-compliance-citations.ts",
    "scripts/generate-evidence-index.ts",
    "scripts/init.ts",
    "templates/**",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify-iso": "bun run scripts/verify-iso-controls.ts",
    "update-sources": "bun run scripts/update-sources.ts",
    "evidence": "bun run scripts/generate-evidence-index.ts",
    "init": "bun run scripts/init.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "typescript": "^5.7.0"
  }
}
